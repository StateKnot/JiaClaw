# Set an immutable image digest after building and validating your release.
JIACLAW_IMAGE=YOUR_REGISTRY/jiaclaw@sha256:YOUR_VERIFIED_DIGEST
# Existing, separately bounded block/quota volumes. Ordinary unlimited volumes are unsuitable.
JIACLAW_GATEWAY_VOLUME=YOUR_BOUNDED_GATEWAY_REGISTRY_VOLUME
JIACLAW_ALICE_VOLUME=YOUR_BOUNDED_ALICE_VOLUME
JIACLAW_BOB_VOLUME=YOUR_BOUNDED_BOB_VOLUME
# Absolute host directory, outside workspaces and this repository.
JIACLAW_SECRET_DIR=/etc/jiaclaw-gateway/secrets
# Only the shared gateway is published, to host loopback for a local TLS proxy.
JIACLAW_GATEWAY_PORT=8088

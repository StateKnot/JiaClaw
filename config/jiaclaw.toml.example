# Only fields consumed by AgentConfig are included. See docs/configuration.md.
[agent]
name = "JiaClaw"
description = "Personal assistant"
system_instructions = "You are JiaClaw, a helpful personal assistant."
max_turns = 10
# Defaults to ~/.jiaclaw/workspace. Use an absolute path; ~ is not expanded.
# workspace_path = "/absolute/path/workspace"
tool_timeout_secs = 45
max_tool_iterations = 5

[provider]
provider_type = "brokerrouter"
# Address of YOUR running gateway, not a public hosted-service promise.
base_url = "http://127.0.0.1:8081"
model = "YOUR_CERTIFIED_LOGICAL_MODEL"
# Set JIACLAW_API_KEY to a Brokerrouter virtual key (recommended).
# api_key = "..."
temperature = 0.7
max_tokens = 4096
# For offline verification only: provider_type = "stub"

[http]
bind = "127.0.0.1:8080"
# Set JIACLAW_API_TOKEN to an independent random API token.
# api_token = "..."
persist = true
# Relative to workspace, but MUST resolve outside workspace.
persist_path = "../state/sessions.sqlite3"
metrics_public = false
rate_limit_per_minute = 60
max_body_bytes = 1048576
shutdown_timeout_secs = 30
# Unset/0: no expiration. Expiration deletes history, including persisted history.
# session_ttl_secs = 2592000
# Channels require explicit installation/identity/tool policies below, SQLite and API Token.
# See docs/channels.md before migrating older webhook configurations.
# webhook_secret = "..."           # JIACLAW_WEBHOOK_SECRET
# telegram_secret = "..."          # JIACLAW_TELEGRAM_SECRET
# telegram_bot_token = "..."       # JIACLAW_TELEGRAM_BOT_TOKEN
# slack_signing_secret = "..."     # JIACLAW_SLACK_SIGNING_SECRET
# slack_bot_token = "..."          # JIACLAW_SLACK_BOT_TOKEN
# feishu_app_secret = "..."        # JIACLAW_FEISHU_APP_SECRET
# feishu_encrypt_key = "..."       # JIACLAW_FEISHU_ENCRYPT_KEY
# feishu_verification_token = "..." # JIACLAW_FEISHU_VERIFICATION_TOKEN
# Feishu uses installation_id="cli_APP:TENANT", without app_id. See docs/feishu.md.
# wecom_app_secret = ""           # JIACLAW_WECOM_APP_SECRET
# wecom_callback_token = ""       # JIACLAW_WECOM_CALLBACK_TOKEN
# wecom_encoding_aes_key = ""     # JIACLAW_WECOM_ENCODING_AES_KEY
# WeCom self-built app: installation_id="CORP_ID:1000002", no app_id or thread_id.
# Member IDs in allowlists must be lowercase. Dedicated app required; see docs/wecom.md.
# discord_public_key = "..."       # JIACLAW_DISCORD_PUBLIC_KEY
# Discord replies use interaction tokens; set JIACLAW_CHANNEL_STATE_KEY (64 hex).
# No Discord Bot Authorization is sent for interaction replies.
# [[http.channels]]
# channel = "telegram"
# installation_id = "123456"  # Numeric prefix of your Bot Token.
# allowed_senders = ["YOUR_USER_ID"]
# allowed_conversations = ["YOUR_CHAT_ID"]
# scheduled_destinations = [{ conversation_id = "YOUR_CHAT_ID" }] # Explicit proactive permission.
# enabled_tools = ["datetime_now"]
# timeout_secs = 120

[http.cors]
enabled = false
allowed_origins = []
allowed_methods = ["GET", "POST", "DELETE", "OPTIONS"]
allowed_headers = ["Authorization", "Content-Type", "X-Request-Id", "Accept"]
expose_headers = ["X-Request-Id"]

[tools.copy]
enabled = true

[tools.exec]
enabled = false
# Enabling requires installed Docker, pre-pulled digest pin, explicit commands,
# and an API token when serving HTTP. Never mounts a Docker socket in a container.
# docker_path = "/usr/bin/docker"  # macOS often /usr/local/bin/docker
# image = "YOUR_IMAGE@sha256:YOUR_64_HEX_DIGEST"
timeout_secs = 30
max_output_bytes = 65536
workspace_read_only = true
user = "65534:65534"
# [tools.exec.commands]
# cat = "/bin/cat"
# ls = "/bin/ls"

[tools.web_search]
enabled = true
# brave_api_key = "..."  # JIACLAW_BRAVE_API_KEY takes precedence.
[tools.web_fetch]
enabled = true
allow_private = false
[tools.memory_search]
enabled = true
[tools.memory_write]
enabled = true
[tools.read_file]
enabled = true
[tools.list_dir]
enabled = true
[tools.write_file]
enabled = true
[tools.delete_file]
enabled = true
[tools.str_replace]
enabled = true
[tools.grep]
enabled = true
[tools.glob]
enabled = true
[tools.mkdir]
enabled = true
[tools.move]
enabled = true

[memory]
path = "MEMORY.md"
[identity]
soul_path = "SOUL.md"
user_path = "USER.md"
[heartbeat]
enabled = false
interval_secs = 3600
path = "HEARTBEAT.md"
session_id = "heartbeat"
[session]
summarize_on_overflow = false
keep_recent = 10
[logging]
format = "text"
level = "info"

# 持久化 cron/interval 任务；启用要求 SQLite、API Token，并关闭 legacy heartbeat。
[scheduler]
enabled = false
